# ---- Shopify (iORA SG) ----
# Admin API access token. Standard format is "shpat_..." (from a custom app).
# The value currently in use starts with "atkn_" — it may or may not authenticate.
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The store's PERMANENT domain, e.g. iora-sg.myshopify.com
# (NOT the public storefront sg.iora.online). Find it in Shopify admin:
# the URL admin.shopify.com/store/<handle>  ->  <handle>.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API version. Use 2025-10 or later: that is the earliest version that exposes
# `shopifyqlQuery` (ShopifyQL — the Analytics engine for Gross Sales, Discounts,
# Sessions, Conversion). On older versions the dashboard falls back to the Orders-based
# reconstruction (sales only; Sessions/Conversion show dashes).
SHOPIFY_API_VERSION=2025-10
