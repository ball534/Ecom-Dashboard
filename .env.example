SHOPIFY_API_VERSION=2025-10

# ---------------------------------------------------------------------------
# Credentials, per Shopify store. Every store uses the SAME three variables:
#
#   DOMAIN_<STORE> + CLIENT_<STORE> + SECRET_<STORE>
#
# These never expire, and the API mints a fresh ~24h Admin API access token
# itself via the OAuth client_credentials grant (see api/_token.js) — which is
# what removes the 24-hour chore. Set them once in Vercel and never touch them
# again. iORA SG used to be the exception, carrying a hand-pasted permanent
# `shpat_` token; it has been moved onto this path so there is one way in.
#
# TOKEN_<STORE> still exists as a BREAK-GLASS OVERRIDE, not a second supported
# setup: where one is set, that store stops minting and the pasted value is used
# verbatim (the API logs a warning saying so). Use it only to keep a store alive
# while its app credentials are being fixed, and delete it afterwards.
# ---------------------------------------------------------------------------

# iORA SG
DOMAIN_IORASG=iora-online.myshopify.com
CLIENT_IORASG=
SECRET_IORASG=

# iORA MY
DOMAIN_IORAMY=e4a547-2.myshopify.com
CLIENT_IORAMY=
SECRET_IORAMY=

# The Restyle Trait
DOMAIN_TRTSG=trt-sg.myshopify.com
CLIENT_TRTSG=
SECRET_TRTSG=

DOMAIN_TRTMY=trt-my.myshopify.com
CLIENT_TRTMY=
SECRET_TRTMY=

# SANS & SANS
DOMAIN_SANSSG=sansandsans-sin.myshopify.com
CLIENT_SANSSG=
SECRET_SANSSG=

DOMAIN_SANSMY=sansandsans-my.myshopify.com
CLIENT_SANSMY=
SECRET_SANSMY=

# MONOLOQ
DOMAIN_MONOSG=monoloq-sg.myshopify.com
CLIENT_MONOSG=
SECRET_MONOSG=

DOMAIN_MONOMY=monoloq-my.myshopify.com
CLIENT_MONOMY=
SECRET_MONOMY=

# ===========================================================================
# ADS  (/api/ads — the Ads tab). Every variable below is optional: a platform
# with no credentials reports reason:"not-configured" and its cards stay blank.
#
# Naming: identifiers are PER STORE and use the same suffixes as Shopify above
# (IORASG, IORAMY, TRTSG, TRTMY, SANSSG, SANSMY, MONOSG, MONOMY). For the two
# iORA stores, the shorter _SG / _MY spellings are accepted too. Credentials
# (tokens, app secrets) fall back store -> market -> bare name, so one token can
# serve every store: META_ACCESS_TOKEN_TRTSG -> META_ACCESS_TOKEN_SG ->
# META_ACCESS_TOKEN.
# ===========================================================================

# Optional ad-performance targets. Leave blank and the Ads tab hides its
# "vs target" chips instead of comparing against an invented number.
# ADS_TARGET_ROAS=5.0
# ADS_TARGET_CTR=0.015

# --- Meta / Facebook (Marketing API) ---
# A Business-Manager SYSTEM USER token with ads_read — long-lived, no App Review
# needed for your own ad accounts. Ad accounts may be comma-separated.
#
# Which act_ id belongs to which brand is set HERE, explicitly, and never inferred
# from the account name: "SANS Ad" and "SANS & SANS - Ad Account" are one rename
# apart, and a rename must not silently re-attribute spend. Same discipline as the
# POS SKU prefixes. Run `npm run meta-accounts` to list every account under the
# business with its id, status, currency and spend, and to have the mapping below
# checked against it.
META_ACCESS_TOKEN=

# The Business Manager the accounts hang off. A system-user token cannot use
# /me/adaccounts (`me` is the system user, which owns no assets) — discovery reads
# <business>/owned_ad_accounts and <business>/client_ad_accounts instead.
# META_BUSINESS_ID=158508188091469

# iORA (the _SG/_MY shorthand is accepted for these two stores only)
META_AD_ACCOUNT_SG=
META_AD_ACCOUNT_MY=
# META_AD_ACCOUNT_TRTSG=
# META_AD_ACCOUNT_TRTMY=
# META_AD_ACCOUNT_SANSSG=
# META_AD_ACCOUNT_SANSMY=
# META_AD_ACCOUNT_MONOSG=
# META_AD_ACCOUNT_MONOMY=

# Accounts that live in the Business Manager but are not brand spend (a personal
# account, a one-off campaign account). act_2311636498906929 is already excluded in
# code; this adds to that list. Excluded by id, never by name.
# META_AD_ACCOUNT_EXCLUDE=
# META_API_VERSION=v23.0

# --- Google Ads ---
# Developer token needs at least Basic access (apply early — 1-2 weeks).
# LOGIN_CUSTOMER_ID is the MCC; CUSTOMER_<STORE> is the account being reported on.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_SG=
GOOGLE_ADS_CUSTOMER_MY=
# GOOGLE_ADS_API_VERSION=v21

# --- TikTok Ads (Business API) ---
# TIKTOK_METRICS / TIKTOK_REVENUE_METRIC only matter if this API version renames
# its metrics: the client falls back to spend/impressions/clicks and says so.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_SG=
TIKTOK_ADVERTISER_MY=
# TIKTOK_API_VERSION=v1.3
# TIKTOK_METRICS=
# TIKTOK_REVENUE_METRIC=

# ===========================================================================
# MARKETPLACES  (/api/marketplace — Channel Mix + marketplace voucher rows)
#
# IMPORTANT: Shopee and Lazada ROTATE their refresh tokens — each refresh
# invalidates the previous one. The variables below are only the SEED pair; the
# live pair is kept in the token store. Set TOKEN_STORE_URL/_TOKEN (any
# Upstash-compatible Redis REST service) before relying on these in production,
# or a redeploy will strand the rotated token and the pull will start failing.
# ===========================================================================

TOKEN_STORE_URL=
TOKEN_STORE_TOKEN=

# --- Shopee Open Platform ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID_SG=
SHOPEE_SHOP_ID_MY=
SHOPEE_ACCESS_TOKEN_SG=
SHOPEE_REFRESH_TOKEN_SG=
SHOPEE_ACCESS_TOKEN_MY=
SHOPEE_REFRESH_TOKEN_MY=
# SHOPEE_HOST=https://partner.shopeemobile.com

# --- Lazada Open Platform ---
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN_SG=
LAZADA_REFRESH_TOKEN_SG=
LAZADA_ACCESS_TOKEN_MY=
LAZADA_REFRESH_TOKEN_MY=
# LAZADA_HOST_SG=https://api.lazada.sg/rest
# LAZADA_HOST_MY=https://api.lazada.com.my/rest
