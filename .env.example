# ===========================================================================
# EMAIL  (/api/email — the Dotdigital card on the Ads tab)
#
# Dotdigital sends for iORA, SANS & SANS and The Restyle Trait (SG + MY).
# Klaviyo sends for the two MONOLOQ stores. Which store uses which is set in
# api/email.js (PROVIDERS) and is never inferred.
#
# THE DOTDIGITAL ACCOUNT IS SHARED; THE KLAVIYO ONE IS NOT. All six Dotdigital
# brands sit in ONE Dotdigital account — so unlike META_AD_ACCOUNT_<STORE>, the
# credential cannot be the attribution there: one login sees every brand's
# campaigns. The split is an explicit id mapping below. Without it a brand
# would show all six brands' sends under its own name, and SGALL / MYALL /
# GROUP would total the same campaign several times over.
#
# Klaviyo is the opposite: its one account is MONOLOQ SG only, so the key is
# the attribution and is scoped per store. See the Klaviyo block below.
#
# Setting ANY of the _FROM_ / _ADDRESS_BOOKS_ / KLAVIYO_LIST_ variables tells
# the code the account is shared; from then on a configured store WITHOUT a
# filter reports "not-configured" rather than quietly serving everything. The
# env is the signal — there is no separate switch to forget.
#
# Splitting on campaign NAME is deliberately not supported: "IORA RED PACKET"
# is one rename away from not matching, and a rename must never re-attribute
# revenue. Same discipline as mapping ad accounts by act_ id.
#
# Run `npm run email-discover` to list this account's from-addresses, address
# books and Klaviyo audiences with send counts, then fill in the ids below.
# Run `npm run preview-email` afterwards: it checks no two stores ended up on
# the same one and exits non-zero if they did.
# ===========================================================================

# r1 = Europe, r2 = North America, r3 = Asia Pacific. Optional: when unset the
# region is discovered from the account (r1 answers account-info from anywhere).
DOTDIGITAL_REGION=r3

# The one API user for the whole account.
# Settings -> Access -> API users; the username looks like
# apiuser-xxxxxxxx@apiconnector.com.
DOTDIGITAL_USER=
DOTDIGITAL_PASS=

# WHICH SENDS BELONG TO WHICH BRAND — pick ONE of the two per store.
#
# By sender. Cheapest: the address is already in the campaign list, so a brand's
# pull never spends a call on another brand's campaign. Comma-separate several.
DOTDIGITAL_FROM_IORASG=
DOTDIGITAL_FROM_IORAMY=
DOTDIGITAL_FROM_TRTSG=
DOTDIGITAL_FROM_TRTMY=
DOTDIGITAL_FROM_SANSSG=
DOTDIGITAL_FROM_SANSMY=

# …or by address book, for a brand whose SG and MY share one sender. Costs one
# extra call per campaign in the WHOLE account the first time (you cannot know a
# campaign is not yours without looking), cached permanently afterwards. Where
# both are set for a store, the from-address wins.
# DOTDIGITAL_ADDRESS_BOOKS_IORASG=
# DOTDIGITAL_ADDRESS_BOOKS_IORAMY=
# DOTDIGITAL_ADDRESS_BOOKS_TRTSG=
# DOTDIGITAL_ADDRESS_BOOKS_TRTMY=
# DOTDIGITAL_ADDRESS_BOOKS_SANSSG=
# DOTDIGITAL_ADDRESS_BOOKS_SANSMY=

# --- Klaviyo (MONOLOQ) ---
# A Private API key (pk_...) with campaigns:read and metrics:read; add
# accounts:read so the reporting currency comes from Klaviyo instead of blank.
#
# UNLIKE DOTDIGITAL, THE KLAVIYO ACCOUNT IS *NOT* SHARED. The Group's only
# Klaviyo account (RE4UJR) is MONOLOQ SG alone — SG sender, SGD, Asia/Singapore,
# no MY audience in any send. So scope the key to the store and leave the bare
# name unset: a bare KLAVIYO_API_KEY also resolves for MONOMY, which would
# report SG's sends under both stores and double them in MYALL and GROUP.
# MONOMY stays "not-configured" until MONOLOQ MY has an account of its own.
KLAVIYO_API_KEY_MONOSG=
# KLAVIYO_API_KEY_MONOMY=
# KLAVIYO_API_KEY=          # bare = one account serves BOTH stores; see below

# Only if one account ever does serve both stores: the audience (list or
# segment) id identifying each. A campaign is that store's when its
# audiences.included contains one of these, and setting either one makes a
# store without a filter "not-configured" instead of a silent duplicate.
# Note RE4UJR could not be split this way — its audiences are lifecycle
# segments (RFM - Champions, ALL CUSTOMER, ...), not markets.
# KLAVIYO_LIST_MONOSG=
# KLAVIYO_LIST_MONOMY=

# The metric revenue is attributed against. Optional: discovered as the
# account's "Placed Order" metric when unset.
# KLAVIYO_CONVERSION_METRIC_MONOSG=
# KLAVIYO_CONVERSION_METRIC_MONOMY=
# KLAVIYO_REVISION=2026-07-15
