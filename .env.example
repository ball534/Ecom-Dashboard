# ---- Shopify (iORA SG) ----
# Admin API access token. Standard format is "shpat_..." (from a custom app).
# The value currently in use starts with "atkn_" — it may or may not authenticate.
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The store's PERMANENT domain, e.g. iora-sg.myshopify.com
# (NOT the public storefront sg.iora.online). Find it in Shopify admin:
# the URL admin.shopify.com/store/<handle>  ->  <handle>.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API version. Use 2025-10 or later: that is the earliest version that exposes
# `shopifyqlQuery` (ShopifyQL — the Analytics engine for Gross Sales, Discounts,
# Sessions, Conversion). On older versions the dashboard falls back to the Orders-based
# reconstruction (sales only; Sessions/Conversion show dashes).
SHOPIFY_API_VERSION=2025-10

# ---- Other stores (multi-brand) ----
# Each brand button on the dashboard is a SEPARATE Shopify store, so it needs its own
# Admin API token + permanent domain. To make a brand live, in that store's admin create
# a custom app (scopes: read_orders, read_reports/read_analytics — same as SG), then set
# the pair below. Brand keys: MY, TRTSG, TRTMY, SANSSG, SANSMY, MONOSG, MONOMY.
# The permanent domain is <handle>.myshopify.com (from admin.shopify.com/store/<handle>),
# NOT the public storefront domain. Any brand left unset simply shows baseline data.
#
# SHOPIFY_TOKEN_MY=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_DOMAIN_MY=iora-my.myshopify.com
# SHOPIFY_TOKEN_TRTSG=shpat_...
# SHOPIFY_DOMAIN_TRTSG=<handle>.myshopify.com
# SHOPIFY_TOKEN_TRTMY=...
# SHOPIFY_DOMAIN_TRTMY=...
# SHOPIFY_TOKEN_SANSSG=...
# SHOPIFY_DOMAIN_SANSSG=...
# SHOPIFY_TOKEN_SANSMY=...
# SHOPIFY_DOMAIN_SANSMY=...
# SHOPIFY_TOKEN_MONOSG=...
# SHOPIFY_DOMAIN_MONOSG=...
# SHOPIFY_TOKEN_MONOMY=...
# SHOPIFY_DOMAIN_MONOMY=...
#
# Optional: a brand on a different API version can override it, e.g.
# SHOPIFY_API_VERSION_MY=2025-10
