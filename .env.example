SHOPIFY_API_VERSION=2025-10

# ---------------------------------------------------------------------------
# Credentials, per Shopify store. Two supported shapes:
#
#   1. Permanent Admin API token   TOKEN_<STORE>  + DOMAIN_<STORE>
#   2. App credentials (preferred) CLIENT_<STORE> + SECRET_<STORE> + DOMAIN_<STORE>
#
# Shape 2 is what removes the 24-hour chore: these values never expire, and the
# API mints a fresh ~24h access token itself via the OAuth client_credentials
# grant (see api/_token.js). Set them once in Vercel and never touch them again.
#
# iORA SG's app issues a permanent token, so it uses shape 1. Every other store's
# token expires after ~24 hours, so it uses shape 2. If both are present for a
# store, TOKEN_<STORE> wins.
# ---------------------------------------------------------------------------

# iORA SG — permanent token
DOMAIN_IORASG=
TOKEN_IORASG=

# iORA MY
DOMAIN_IORAMY=
CLIENT_IORAMY=
SECRET_IORAMY=

# The Restyle Trait
DOMAIN_TRTSG=
CLIENT_TRTSG=
SECRET_TRTSG=

DOMAIN_TRTMY=
CLIENT_TRTMY=
SECRET_TRTMY=

# SANS & SANS
DOMAIN_SANSSG=
CLIENT_SANSSG=
SECRET_SANSSG=

DOMAIN_SANSMY=
CLIENT_SANSMY=
SECRET_SANSMY=

# MONOLOQ
DOMAIN_MONOSG=
CLIENT_MONOSG=
SECRET_MONOSG=

DOMAIN_MONOMY=
CLIENT_MONOMY=
SECRET_MONOMY=
